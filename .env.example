# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# DATABASE_URL will be selected automatically via scripts/run-with-db-fallback.mjs
DATABASE_URL_LOCAL="postgresql://USER@localhost:5432/bazaar_db?schema=public"
DATABASE_URL_REMOTE="postgresql://USER:PASSWORD@REMOTE_HOST:PORT/bazaar_db?schema=public"
DATABASE_URL="postgresql://USER@localhost:5432/bazaar_db?schema=public"

# NextAuth.js — generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-here-minimum-32-chars"
NEXTAUTH_URL="http://localhost:3000"

# Public API URL (used by axios on client side)
NEXT_PUBLIC_API_URL="http://localhost:3000"

# Vendor/admin earning split (percentage kept by admin)
ADMIN_COMMISSION_PERCENT="5"
