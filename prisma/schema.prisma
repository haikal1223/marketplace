generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum Role {
  CUSTOMER
  VENDOR
  ADMIN
}

enum OrderStatus {
  Pending
  Processing
  Delivered
  Cancelled
}

enum TicketStatus {
  Open
  Closed
  Pending
}

// ============================================================
// USER
// ============================================================

model User {
  id          String    @id @default(cuid())
  email       String    @unique
  phone       String?
  avatar      String?
  password    String
  dateOfBirth DateTime?
  firstName   String
  lastName    String
  verified    Boolean   @default(false)
  role        Role      @default(CUSTOMER)
  balance     Float     @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  shop            Shop?
  orders          Order[]
  addresses       Address[]
  payments        Payment[]
  reviews         Review[]
  tickets         Ticket[]
  wishlistItems   WishlistItem[]
}

// ============================================================
// SHOP
// ============================================================

model Shop {
  id             String   @id @default(cuid())
  slug           String   @unique
  userId         String   @unique
  email          String
  name           String
  phone          String
  address        String
  verified       Boolean  @default(false)
  coverPicture   String
  profilePicture String
  facebookUrl    String?
  youtubeUrl     String?
  twitterUrl     String?
  instagramUrl   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  products       Product[]
  warehouses     ShopWarehouse[]
  payoutRequests PayoutRequest[]
  refundRequests RefundRequest[]
  siteSetting    VendorSiteSetting?
  payoutSetting  VendorPayoutSetting?
}

// ============================================================
// SHOP WAREHOUSE (multi-origin shipping)
// ============================================================
model ShopWarehouse {
  id                String   @id @default(cuid())
  shopId            String
  name              String
  originDistrictId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  products Product[]

  @@unique([shopId, name])
}

model VendorSiteSetting {
  id         String   @id @default(cuid())
  shopId      String   @unique
  general     Json?
  topbar      Json?
  footer      Json?
  socialLinks Json?
  shippingVat Json?
  bannerSlider Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
}

model VendorPayoutSetting {
  id        String   @id @default(cuid())
  shopId     String   @unique
  cash       Json?
  card       Json?
  bank       Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
}

// ============================================================
// CATEGORY
// ============================================================

model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  icon        String?
  image       String?
  featured    Boolean    @default(false)
  description String?
  parentId    String?
  createdAt   DateTime   @default(now())

  parent   Category?  @relation("CategoryChildren", fields: [parentId], references: [id])
  children Category[] @relation("CategoryChildren")
  products ProductCategory[]
}

// ============================================================
// BRAND
// ============================================================

model Brand {
  id       String    @id @default(cuid())
  name     String
  slug     String    @unique
  type     String
  image    String
  featured Boolean   @default(false)
  createdAt DateTime @default(now())

  products Product[]
}

// ============================================================
// PRODUCT
// ============================================================

model Product {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  price       Float
  discount    Float    @default(0)
  rating      Float    @default(0)
  thumbnail   String
  description String?
  status      String?
  published   Boolean  @default(true)
  stock       Int      @default(0)
  weight      Int      @default(500)
  tags        String[]
  shopId      String?
  brandId     String?
  warehouseId String?
  colors      String[]
  sizes       String[]
  images      String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  shop       Shop?            @relation(fields: [shopId], references: [id], onDelete: SetNull)
  warehouse  ShopWarehouse?  @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  brand      Brand?           @relation(fields: [brandId], references: [id], onDelete: SetNull)
  categories ProductCategory[]
  reviews         Review[]
  orderItems      OrderItem[]
  wishlistItems   WishlistItem[]
}

// ============================================================
// WISHLIST
// ============================================================

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

// ============================================================
// PRODUCT <-> CATEGORY (join table)
// ============================================================

model ProductCategory {
  productId  String
  categoryId String

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
}

// ============================================================
// REVIEW
// ============================================================

model Review {
  id         String   @id @default(cuid())
  rating     Float
  comment    String
  published  Boolean  @default(true)
  customerId String
  productId  String
  createdAt  DateTime @default(now())

  customer User    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product  Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

// ============================================================
// ORDER
// ============================================================

model Order {
  id              String      @id @default(cuid())
  userId          String
  tax             Float       @default(0)
  discount        Float       @default(0)
  shippingCost    Float       @default(0)
  totalPrice      Float
  isDelivered     Boolean     @default(false)
  shippingAddress String
  courierName     String?
  courierService  String?
  courierEtd      String?
  paymentMethod   String      @default("COD")
  status          OrderStatus @default(Pending)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  deliveredAt     DateTime?

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items         OrderItem[]
  refundRequest RefundRequest?
}

// ============================================================
// ORDER ITEM
// ============================================================

model OrderItem {
  id              String  @id @default(cuid())
  orderId         String
  productId       String?
  productImg      String
  productName     String
  productPrice    Float
  productQuantity Int
  variant         String?

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
}

// ============================================================
// ADDRESS
// ============================================================

model Address {
  id      String @id @default(cuid())
  userId  String
  city    String
  title   String
  phone   String
  street  String
  country String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============================================================
// PAYMENT METHOD
// ============================================================

model Payment {
  id            String @id @default(cuid())
  userId        String
  exp           String
  cardNo        String
  paymentMethod String
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============================================================
// SUPPORT TICKET
// ============================================================

model Ticket {
  id        String       @id @default(cuid())
  slug      String       @unique
  userId    String
  type      String
  title     String
  status    TicketStatus @default(Open)
  category  String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages TicketMessage[]
}

model TicketMessage {
  id        String   @id @default(cuid())
  ticketId  String
  name      String
  text      String
  imgUrl    String?
  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
}

// ============================================================
// PAYOUT REQUEST (vendor -> admin)
// ============================================================

model PayoutRequest {
  id        String   @id @default(cuid())
  shopId    String
  amount    Float
  status    String   @default("Pending")
  message   String?
  createdAt DateTime @default(now())

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
}

// ============================================================
// REFUND REQUEST
// ============================================================

model RefundRequest {
  id           String   @id @default(cuid())
  orderId      String   @unique
  shopId       String
  amount       Float
  status       String   @default("Pending")
  productName  String
  productImage String
  orderNo      String
  createdAt    DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  shop  Shop  @relation(fields: [shopId], references: [id], onDelete: Cascade)
}
